{
  "expo": {
    "name": "Escuta Alertas",
    "slug": "escuta-alertas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escutaalertas",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.escutaalertas.app"
    },
    "android": {
      "package": "com.escutaalertas.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F6BFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Escuta Alertas precisa do microfone para detectar palavras-chave de emergência.",
          "speechRecognitionPermission": "O Escuta Alertas usa reconhecimento de voz para identificar alertas.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2F6BFF",
          "defaultChannel": "alerts"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Escuta Alertas usa sua localização para incluir no alerta de emergência enviado pelo WhatsApp."
        }
      ],
      "./plugins/withNotifeeMicrophone.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "escuta-alertas-local"
      }
    }
  }
}
