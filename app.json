{
  "expo": {
    "name": "Vigintel",
    "slug": "escuta-alertas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "escutaalertas",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.escutaalertas.app"
    },
    "android": {
      "package": "com.escutaalertas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1F45FF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "android": {
            "launchMode": "most-recent",
            "defaultLaunchURL": "http://127.0.0.1:8081"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-empty.png",
          "resizeMode": "contain",
          "backgroundColor": "#1F45FF",
          "imageWidth": 1
        }
      ],
      "./modules/vigintel-listener/app.plugin.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1F45FF",
          "defaultChannel": "alerts-v2"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vigintel usa sua localização para incluir no alerta de emergência enviado pelo WhatsApp."
        }
      ],
      "./plugins/withNotifeeMicrophone.js",
      "./plugins/withBuildDirOutsideOneDrive.js",
      [
        "react-native-vosk",
        {
          "models": ["assets/model-small-pt"],
          "iOSMicrophonePermission": "O Vigintel precisa do microfone para reconhecer frases-código offline."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "escuta-alertas-local"
      }
    }
  }
}
