# URL da Edge Function send-alert.
# Palavras, contatos e histórico usam a função catalog no mesmo endereço.
EXPO_PUBLIC_ALERT_ENDPOINT=https://SEU_PROJECT_REF.supabase.co/functions/v1/send-alert

# Mesmo valor do secret ALERT_INGEST_SECRET da função. Não commitar o .env real.
EXPO_PUBLIC_ALERT_INGEST_SECRET=

# Login com e-mail e senha. Use a chave publicável do projeto, nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
