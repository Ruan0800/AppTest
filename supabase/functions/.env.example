# Secrets da Edge Function send-alert.
# Copie para supabase/functions/.env no ambiente local. Esse arquivo real é ignorado pelo git.
# Em produção: supabase secrets set --env-file supabase/functions/.env
# O valor vale na hora, sem novo deploy da função.

ALERT_INGEST_SECRET=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Um dos dois basta. Messaging Service é o caminho para SMS no Brasil.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
